---
import BlogShell from '../../layouts/BlogShell.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const years = new Set<number>();
let hasUndatedPosts = false;
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  if (year > 1970) years.add(year);
  else hasUndatedPosts = true;
}
const sortedYears = [...years].sort((a, b) => b - a);
---

<BlogShell title={`Blog - ${SITE_TITLE}`} description="Sogud 的文章归档，记录软件开发、技术实践和个人思考。">
  <main id="main" class="archive-main">
    <header class="archive-intro">
      <p class="blog-eyebrow">文章归档 / {posts.length} 篇</p>
      <h1>想过的，做过的，<br />写下来。</h1>
      <p class="archive-description">软件开发、技术实践，以及一些个人思考。</p>
    </header>
    <section aria-label="查找文章">
      <form class="archive-filters" action="/blog/" method="get">
        <div class="search-field">
          <label for="article-search">搜索文章</label>
          <input id="article-search" name="q" type="search" placeholder="标题、摘要或关键词" autocomplete="off" />
        </div>
        <div class="year-field">
          <label for="article-year">年份</label>
          <select id="article-year" name="year">
            <option value="">全部年份</option>
            {sortedYears.map(year => <option value={year}>{year}</option>)}
            {hasUndatedPosts && <option value="archive">日期待考</option>}
          </select>
        </div>
        <button class="clear-filters" type="reset" hidden>清空筛选</button>
      </form>
      <p id="article-count" class="filter-count" role="status" aria-live="polite">共 {posts.length} 篇文章</p>
      <ol class="archive-list">
        {posts.map(post => (
          <li class="archive-row" data-article data-year={post.data.pubDate.getUTCFullYear() > 1970 ? post.data.pubDate.getUTCFullYear() : 'archive'} data-search={`${post.data.title} ${post.data.description} ${(post.data.tags ?? []).join(' ')}`.toLocaleLowerCase()}>
            <div class="archive-date">
              {post.data.pubDate.getUTCFullYear() > 1970 ? <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN', { timeZone: 'UTC', year: 'numeric', month: '2-digit', day: '2-digit' })}</time> : <span>历史文章</span>}
            </div>
            <div class="archive-entry">
              <h2><a href={`/blog/${post.slug}/`}>{post.data.title}<span class="article-arrow" aria-hidden="true">↗</span></a></h2>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <div id="no-articles" class="archive-empty" hidden={posts.length > 0}>
        <h2>没有找到匹配的文章</h2>
        <p>试试更短的关键词，或清空年份和搜索条件。</p>
      </div>
    </section>
  </main>
</BlogShell>

<script>
  const form = document.querySelector<HTMLFormElement>('.archive-filters');
  const search = document.querySelector<HTMLInputElement>('#article-search');
  const year = document.querySelector<HTMLSelectElement>('#article-year');
  const clear = document.querySelector<HTMLButtonElement>('.clear-filters');
  const count = document.querySelector<HTMLElement>('#article-count');
  const empty = document.querySelector<HTMLElement>('#no-articles');
  const articles = document.querySelectorAll<HTMLElement>('[data-article]');

  function filterArticles() {
    if (!form || !search || !year || !clear || !count || !empty) return;
    const query = search.value.trim().toLocaleLowerCase();
    const selectedYear = year.value;
    let visible = 0;
    for (const article of articles) {
      const matchesQuery = article.dataset.search?.includes(query) ?? false;
      const matchesYear = !selectedYear || article.dataset.year === selectedYear;
      article.hidden = !matchesQuery || !matchesYear;
      if (!article.hidden) visible++;
    }
    count.textContent = query || selectedYear ? `找到 ${visible} 篇文章` : `共 ${visible} 篇文章`;
    empty.hidden = visible > 0;
    clear.hidden = !query && !selectedYear;

    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', search.value.trim());
    else url.searchParams.delete('q');
    if (selectedYear) url.searchParams.set('year', selectedYear);
    else url.searchParams.delete('year');
    history.replaceState(null, '', url);
  }

  if (form && search && year) {
    const params = new URLSearchParams(window.location.search);
    search.value = params.get('q') ?? '';
    const initialYear = params.get('year') ?? '';
    for (const option of year.options) {
      if (option.value === initialYear) year.value = initialYear;
    }
    form.addEventListener('submit', event => { event.preventDefault(); filterArticles(); });
    form.addEventListener('reset', () => { search.value = ''; year.value = ''; filterArticles(); });
    search.addEventListener('input', filterArticles);
    year.addEventListener('change', filterArticles);
    filterArticles();
  }
</script>
