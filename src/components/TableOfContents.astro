---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const toc = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4);
const firstDepth = Math.min(...toc.map(heading => heading.depth));
---

{toc.length > 0 && <details class="toc-panel" open>
  <summary>本文目录</summary>
  <nav aria-label="跳到章节">
    <ul class="toc-links">
      {toc.map(heading => <li class={`toc-level-${heading.depth - firstDepth + 2}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
    </ul>
  </nav>
</details>}

<script>
  const panel = document.querySelector<HTMLDetailsElement>('.toc-panel');
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-links a');
  const sections: { heading: HTMLElement; link: HTMLAnchorElement }[] = [];
  for (const link of links) {
    const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (heading) sections.push({ heading, link });
  }
  const compact = window.matchMedia('(max-width: 1000px)');
  if (panel) {
    panel.open = !compact.matches;
    compact.addEventListener('change', () => { panel.open = !compact.matches; });
    for (const link of links) {
      link.addEventListener('click', () => { if (compact.matches) panel.open = false; });
    }
  }

  let ticking = false;
  function updateActiveHeading() {
    let current: HTMLAnchorElement | undefined;
    for (const section of sections) {
      if (section.heading.getBoundingClientRect().top <= 132) current = section.link;
    }
    for (const link of links) {
      if (link === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateActiveHeading);
  }, { passive: true });
  window.addEventListener('resize', updateActiveHeading);
  updateActiveHeading();
</script>
